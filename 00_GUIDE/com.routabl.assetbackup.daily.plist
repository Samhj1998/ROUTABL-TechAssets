<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.routabl.assetbackup.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>-gj</string>
    <string>-a</string>
    <string>Terminal</string>
