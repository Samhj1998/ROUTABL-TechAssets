#!/bin/bash
# 라우터블 기술자산 검색 v1.6 실행기: 서버가 없으면 켜고, 준비되면 브라우저로 엽니다.
S="$HOME/Library/Application Support/ROUTABL-AssetSearch"
URL="http://127.0.0.1:8770/"
if ! /usr/bin/curl -s -o /dev/null --max-time 1 "$URL"; then
  cd "$S" || exit 1
  PYTHONDONTWRITEBYTECODE=1 /usr/bin/nohup /usr/bin/python3 -B "$S/routabl_search_v1_6_service.py" serve >/dev/null 2>&1 &
  for i in $(seq 1 60); do
    sleep 0.25
    /usr/bin/curl -s -o /dev/null --max-time 1 "$URL" && break
  done
fi
/usr/bin/open "$URL"
