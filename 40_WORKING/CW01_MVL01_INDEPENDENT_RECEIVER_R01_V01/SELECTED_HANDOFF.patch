+def selected_ref(db, asset_id):
+    """Resolve one explicit ID without search ranking or SHA-based grouping."""
+    index_path = "MVL/" + asset_id
+    rows = db.execute(
+        "SELECT s.reference_json, d.sha, d.sz, d.carrier "
+        "FROM mvl_sources AS s LEFT JOIN docs AS d ON d.path = s.index_path "
+        "WHERE s.index_path = ?", (index_path,)
+    ).fetchmany(2)
+    if not rows:
+        raise ValueError("SELECTED_ASSET_NOT_REGISTERED: " + asset_id)
+    if len(rows) != 1:
+        raise ValueError("DUPLICATE_SELECTED_ASSET_ID: " + asset_id)
+    raw, indexed_sha, indexed_size, carrier = rows[0]
+    stored = json.loads(raw)
+    if (not isinstance(stored, dict) or stored.get("asset_id") != asset_id
+            or stored.get("registration") != "ISOLATED_CANDIDATE"):
+        raise ValueError("INVALID_SELECTED_REGISTRATION: " + asset_id)
+
+    version = stored.get("source_version")
+    path = stored.get("source_path")
+    sha = stored.get("expected_sha256")
+    size = stored.get("expected_size_bytes")
+    if (not isinstance(version, str) or not USER_VERSION.fullmatch(version)
+            or not isinstance(path, str) or path != str(Path(path))
+            or not isinstance(sha, str) or not SHA.fullmatch(sha)
+            or type(size) is not int or size < 0):
+        raise ValueError("INVALID_SELECTED_METADATA: " + asset_id)
+    ref = make_ref(asset_id, version, path, sha, size, "ISOLATED_CANDIDATE")
+    if not overlay_ref_allowed(ref, {}):
+        raise ValueError("SELECTED_SOURCE_PATH_NOT_ALLOWED: " + asset_id)
+    if carrier != "MVL_ISOLATED" or (indexed_sha, indexed_size) != (sha, size):
+        raise ValueError("SELECTED_INDEX_MISMATCH: " + asset_id)
+    verified = verify_source(ref, indexed_sha)
+    if verified["status"] != "LOCAL_HASH_MATCH":
+        raise ValueError(f"SELECTED_SOURCE_NOT_VERIFIED: {asset_id}: {verified['status']}")
+    return verified
+
